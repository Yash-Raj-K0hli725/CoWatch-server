# Copy to .env and fill in real values. .env is gitignored -- never commit
# real credentials.

PORT=8090

# --- Object storage (Cloudflare R2 / any S3-compatible endpoint) -------
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_KEY=
STORAGE_S3_API=https://<account-id>.r2.cloudflarestorage.com
BUCKET_NAME=co-watch

# --- Transcode pipeline --------------------------------------------------
ORIGIN_BUCKET_NAME=co-watch
PUBLIC_CDN_BASE_URL=https://cdn.myapp.com

# Redis: message queue (Streams) + pub/sub (video-ready notifications).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_STREAM_NAME=streamroom:transcode-jobs
QUEUE_CONSUMER_GROUP=transcode-workers

# HMAC secret the storage-event webhook validates
# `X-StreamRoom-Signature` against. Generate a real random value for
# anything internet-reachable.
WEBHOOK_SIGNING_SECRET=

# Go worker fleet (cmd/worker).
WORKER_CONCURRENCY=2
WORKER_VISIBILITY_TIMEOUT=30m
WORKER_MAX_DELIVERIES=3
WORKER_RECLAIM_INTERVAL=1m
TRANSCODE_TEMP_DIR=/tmp/streamroom
MAX_DOWNLOAD_BYTES=2147483648
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_PRESET=veryfast

# --- Auth ------------------------------------------------------------
JWT_SECRET_KEY=
